exports[`ASAP should not throw if short arrays are passed in 1`] = `
Array [
  Object {
    "x": 0,
    "y": 1,
  },
]
`;

exports[`ASAP should not throw if short arrays are passed in 2`] = `
Array [
  Object {
    "x": 0,
    "y": 1,
  },
  Object {
    "x": 0,
    "y": 2,
  },
]
`;

